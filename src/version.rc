            VALUE "OriginalFilename", "agent.exe"
            VALUE "ProductName", "StarMedia Pro Agent"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

2 ICON "app.ico"

